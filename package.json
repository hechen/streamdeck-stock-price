    "check": "npm run typecheck && npm run build && npm run validate"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.9.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "rollup": "4.63.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
